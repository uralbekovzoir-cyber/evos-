def get_regions_keyboard():
    keyboard = []
    row = []
    for key, data in UZB_DATA["regions"].items():
        row.append(InlineKeyboardButton(text=data["name"], callback_data=f"reg:{key}"))
        if len(row) == 2:
            keyboard.append(row)
            row = []
    if row:
        keyboard.append(row)
    return InlineKeyboardMarkup(inline_keyboard=keyboard)


def get_districts_keyboard(reg_key):
    keyboard = []
    row = []
    districts = UZB_DATA["regions"][reg_key]["districts"]
    
    for dist_key, dist_data in districts.items():
        row.append(InlineKeyboardButton(text=dist_data["name"], callback_data=f"dist:{reg_key}:{dist_key}"))
        if len(row) == 2:
            keyboard.append(row)
            row = []
    if row:
        keyboard.append(row)
        
    keyboard.append([InlineKeyboardButton(text="⬅️ Bosh sahifaga qaytish", callback_data="back_to_main")])
    return InlineKeyboardMarkup(inline_keyboard=keyboard)


@dp.message(CommandStart())
async def cmd_start(message: types.Message):
    await message.answer_photo(
        photo=UZB_DATA["photo"],
        caption=UZB_DATA["caption"],
        reply_markup=get_regions_keyboard(),
        parse_mode="Markdown"
    )


@dp.callback_query(F.data == "back_to_main")
async def back_to_main(call: types.CallbackQuery):
    await call.message.answer_photo(
        photo=UZB_DATA["photo"],
        caption=UZB_DATA["caption"],
        reply_markup=get_regions_keyboard(),
        parse_mode="Markdown"
    )
    await call.message.delete()
    await call.answer()


@dp.callback_query(F.data.startswith("reg:"))
async def show_region(call: types.CallbackQuery):
    reg_key = call.data.split(":")[1]
    region = UZB_DATA["regions"].get(reg_key)

    if region:
