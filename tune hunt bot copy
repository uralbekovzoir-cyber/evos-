# @BotFather dan olgan tokenni shu yerga qo'ying
BOT_TOKEN = "SIZNING_BOT_TOKENINGIZ"
bot = telebot.TeleBot(BOT_TOKEN)

# Foydalanuvchilarning tillari va linklarini saqlash uchun
user_languages = {}
user_links = {}

LANGS = {
    'uz': {
        'welcome': "Salom! 🎵 Menga qo'shiq nomini yozing yoki YouTube, Instagram linkini tashlang.\n\nTilni o'zgartirish uchun /language buyrug'ini bosing.",
        'choose_lang': "Iltimos, tilni tanlang:",
        'lang_changed': "Til O'zbek tiliga o'zgartirildi! 🇺🇿",
        'searching': "🔍 Qidirilmoqda, biroz kuting...",
        'link_received': "📥 Link qabul qilindi. Nima yuklab olmoqchisiz?",
        'choose_video_format': "🎬 Video formatini tanlang:",
        'downloading': "⏳ Fayl yuklanmoqda, biroz kuting...",
        'not_found': "❌ Hech narsa topilmadi.",
        'results': "🎶 **'{query}'** bo'yicha natijalar:\n\n",
        'error': "⚠️ Yuklab olishda xatolik yuz berdi: "
    },
    'en': {
        'welcome': "Hello! 🎵 Send me a song name or a YouTube, Instagram link.\n\nTo change language, type /language.",
        'choose_lang': "Please choose your language:",
        'lang_changed': "Language changed to English! 🇬🇧",
        'searching': "🔍 Searching, please wait...",
        'link_received': "📥 Link received. What would you like to download?",
        'choose_video_format': "🎬 Choose video format:",
        'downloading': "⏳ Downloading file, please wait...",
        'not_found': "❌ Nothing found.",
        'results': "🎶 Results for **'{query}'**:\n\n",
        'error': "⚠️ Download error: "
    }
