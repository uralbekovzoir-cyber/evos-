def get_lang(user_id):
    return user_languages.get(user_id, 'uz')

@bot.message_handler(commands=['start'])
def send_welcome(message):
    user_id = message.from_user.id
    if user_id not in user_languages:
        user_languages[user_id] = 'uz'
    lang = get_lang(user_id)
    bot.reply_to(message, LANGS[lang]['welcome'])

@bot.message_handler(commands=['language'])
def change_language(message):
    user_id = message.from_user.id
    lang = get_lang(user_id)
    markup = types.InlineKeyboardMarkup()
    markup.add(
        types.InlineKeyboardButton("🇺🇿 O'zbekcha", callback_data="lang_uz"),
        types.InlineKeyboardButton("🇬🇧 English", callback_data="lang_en")
    )
    bot.reply_to(message, LANGS[lang]['choose_lang'], reply_markup=markup)

@bot.callback_query_handler(func=lambda call: call.data.startswith("lang_"))
def set_language(call):
    user_id = call.from_user.id
    lang = call.data.split("_")[1]
    user_languages[user_id] = lang
    bot.answer_callback_query(call.id, "Saved!")
    bot.edit_message_text(LANGS[lang]['lang_changed'], call.message.chat.id, call.message.message_id)

@bot.message_handler(func=lambda message: True)
def handle_message(message):
    user_id = message.from_user.id
    lang = get_lang(user_id)
    text = message.text.strip()
    
    if "youtube.com" in text or "youtu.be" in text or "instagram.com" in text or "pinterest.com" in text or "pin.it" in text:
        user_links[user_id] = text  
        
        markup = types.InlineKeyboardMarkup(row_width=3)
        markup.add(
            types.InlineKeyboardButton("🎬 Video", callback_data="choice_video"),
            types.InlineKeyboardButton("🎵 Audio", callback_data="choice_audio"),
            types.InlineKeyboardButton("🖼 Rasm", callback_data="choice_image")
        )
        bot.reply_to(message, LANGS[lang]['link_received'], reply_markup=markup)
    else:
        msg = bot.reply_to(message, LANGS[lang]['searching'])
        ydl_opts = {'quiet': True, 'extract_flat': True, 'default_search': 'ytsearch3', 'noplaylist': True}

        try:
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(text, download=False)
                entries = info.get('entries', [])

            if not entries:
                bot.edit_message_text(LANGS[lang]['not_found'], message.chat.id, msg.message_id)
                return

            markup = types.InlineKeyboardMarkup()
            res_text = LANGS[lang]['results'].format(query=text)

            for idx, entry in enumerate(entries, 1):
                video_id = entry['id']
                title = entry.get('title', 'Noma\'lum')[:45]
                duration = entry.get('duration')
                dur_str = f"{int(duration // 60)}:{int(duration % 60):02d}" if duration else ""
                res_text += f"**{idx}.** {title} `{dur_str}`\n"
                markup.add(types.InlineKeyboardButton(text=f"{idx}", callback_data=f"dl_{video_id}"))

            bot.edit_message_text(res_text, message.chat.id, msg.message_id, reply_markup=markup, parse_mode="Markdown")
        except Exception as e:
            bot.edit_message_text(LANGS[lang]['error'] + str(e), message.chat.id, msg.message_id)

@bot.callback_query_handler(func=lambda call: call.data in ["choice_video", "choice_audio", "choice_image"])
def handle_choices(call):
    user_id = call.from_user.id
    lang = get_lang(user_id)
    url = user_links.get(user_id)
    
    if not url:
        bot.answer_callback_query(call.id, "Link topilmadi!")
        return

    if call.data == "choice_video":
        markup = types.InlineKeyboardMarkup(row_width=2)
        markup.add(
            types.InlineKeyboardButton("HD Video", callback_data="vid_hd"),
            types.InlineKeyboardButton("SD Video", callback_data="vid_sd")
        )
        bot.edit_message_text(LANGS[lang]['choose_video_format'], call.message.chat.id, call.message.message_id, reply_markup=markup)

    elif call.data == "choice_audio":
        bot.answer_callback_query(call.id, "Audio...")
        status_msg = bot.send_message(call.message.chat.id, LANGS[lang]['downloading'])
        
        ydl_opts = {
            'format': 'bestaudio/best',
            'outtmpl': '%(id)s.%(ext)s',
            'postprocessors': [{'key': 'FFmpegExtractAudio', 'preferredcodec': 'mp3', 'preferredquality': '192'}],
            'quiet': True,
        }
        try:
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(url, download=True)
                video_id = info.get('id', 'audio')
                title = info.get('title', 'Audio')
                filename = f"{video_id}.mp3"
                if not os.path.exists(filename):
                    for f in os.listdir('.'):
                        if f.startswith(str(video_id)) and f.endswith('.mp3'):
                            filename = f
                            break

            with open(filename, 'rb') as audio:
                bot.send_audio(call.message.chat.id, audio, title=title)
            bot.delete_message(call.message.chat.id, status_msg.message_id)
            if os.path.exists(filename):
                os.remove(filename)
        except Exception as e:
            bot.edit_message_text(LANGS[lang]['error'] + str(e), call.message.chat.id, status_msg.message_id)

    elif call.data == "choice_image":
        bot.answer_callback_query(call.id, "Rasm...")
        status_msg = bot.send_message(call.message.chat.id, LANGS[lang]['downloading'])
        
        ydl_opts = {'skip_download': True, 'quiet': True}
        try:
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info = ydl.extract_info(url, download=False)
                thumbnail_url = info.get('thumbnail')
                title = info.get('title', 'Rasm')

            if thumbnail_url:
                bot.send_photo(call.message.chat.id, thumbnail_url, caption=f"🖼 {title}")
            else:
                bot.send_message(call.message.chat.id, "❌ Rasm topilmadi.")
            bot.delete_message(call.message.chat.id, status_msg.message_id)
        except Exception as e:
            bot.edit_message_text(LANGS[lang]['error'] + str(e), call.message.chat.id, status_msg.message_id)

@bot.callback_query_handler(func=lambda call: call.data in ["vid_hd", "vid_sd"])
def handle_video_download(call):
    user_id = call.from_user.id
    lang = get_lang(user_id)
    url = user_links.get(user_id)
    
    bot.answer_callback_query(call.id, "Video...")
    status_msg = bot.send_message(call.message.chat.id, LANGS[lang]['downloading'])
    
    # Yangi va barqaror video formati sozlamasi
    ydl_opts = {
        'format': 'bestvideo+bestaudio/best',
        'outtmpl': '%(id)s.%(ext)s',
        'merge_output_format': 'mp4',
        'quiet': True,
    }
    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=True)
            video_id = info.get('id', 'video')
            title = info.get('title', 'Video')
            
            filename = f"{video_id}.mp4"
            if not os.path.exists(filename):
                for f in os.listdir('.'):
                    if f.startswith(str(video_id)):
                        filename = f
                        break

        with open(filename, 'rb') as video:
            bot.send_video(call.message.chat.id, video, caption=title)
        bot.delete_message(call.message.chat.id, status_msg.message_id)
        if os.path.exists(filename):
            os.remove(filename)
    except Exception as e:
        bot.edit_message_text(LANGS[lang]['error'] + str(e), call.message.chat.id, status_msg.message_id)

